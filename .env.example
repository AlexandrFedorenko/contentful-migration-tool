# ─────────────────────────────────────────────────────────────────────────────
# Contentful Migration Tool configuration.
# Development: copy to .env.   Production: copy to .env.production (see docs/DEPLOYMENT.md).
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the app, no trailing slash. Must be https in production.
APP_URL=http://localhost:3000

# ── Database / Redis ─────────────────────────────────────────────────────────
# Development (docker compose up -d):
DATABASE_URL=postgresql://cmt:cmt_dev_password@localhost:5432/cmt
REDIS_URL=redis://localhost:6379
# Production (docker-compose.prod.yml builds the URLs from these):
POSTGRES_USER=cmt
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=cmt
REDIS_PASSWORD=change-me-long-random

# ── Secrets ──────────────────────────────────────────────────────────────────
# Encrypts stored Contentful tokens. Generate: openssl rand -base64 32
# Losing it makes stored tokens unreadable (users simply sign in again).
ENCRYPTION_KEY=
# During key rotation only: the previous key (then run `npm run secrets:rotate`).
# ENCRYPTION_KEY_PREVIOUS=
# Upgrading from the Clerk version: the old CLERK_SECRET_KEY, to read tokens it encrypted.
# LEGACY_ENCRYPTION_SECRET=

# ── Sign-in ──────────────────────────────────────────────────────────────────
# OAuth app from Contentful: Organization settings → OAuth applications.
# Redirect URI: <APP_URL>/auth/callback   Scope: content_management_manage
CONTENTFUL_OAUTH_CLIENT_ID=
# Also allow sign-in with a personal access token (CFPAT-...).
ALLOW_TOKEN_LOGIN=true
# Emails that become administrators when they sign in (comma separated).
BOOTSTRAP_ADMIN_EMAILS=
SESSION_TTL_DAYS=14

# ── Runtime ──────────────────────────────────────────────────────────────────
# Backups, asset archives, uploads and job scratch space (shared by web and worker).
DATA_DIR=./data
# Reverse proxies in front of the app (1 with the bundled Caddy).
TRUST_PROXY_HOPS=0
# Contentful Management API budget per space (requests/second, shared by all workers).
CMA_RATE_LIMIT_RPS=6
# Jobs executed in parallel by one worker process.
WORKER_CONCURRENCY=4

# ── Production reverse proxy (Caddy, automatic HTTPS) ────────────────────────
DOMAIN=migrate.example.com
ACME_EMAIL=admin@example.com
