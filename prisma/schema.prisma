generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

enum TokenKind {
  OAUTH // issued by the Contentful OAuth flow on sign-in
  PAT   // personal access token added by the user
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id               String    @id @default(uuid())
  /// Contentful user id (sys.id from GET /users/me). Primary identity.
  contentfulUserId String?   @unique
  /// Legacy Clerk identity, kept to link accounts created before the Contentful sign-in.
  clerkId          String?   @unique
  email            String    @unique
  firstName        String?
  lastName         String?
  displayName      String?
  avatarUrl        String?
  role             Role      @default(MEMBER)
  suspendedAt      DateTime?
  lastLoginAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scripts        Script[]
  backups        BackupRecord[]
  templates      VisualBuilderTemplate[]
  tokens         ContentfulToken[]
  supportTickets SupportRequest[]
  sessions       Session[]
  jobs           Job[]
}

model Session {
  /// sha256 of the random session secret stored in the cookie; the raw value is never persisted.
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model ContentfulToken {
  id         String    @id @default(uuid())
  alias      String
  /// AES-256-GCM encrypted token (see src/lib/encryption.ts), AAD = token:<userId>
  token      String
  kind       TokenKind @default(PAT)
  isActive   Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SupportRequest {
  id            String   @id @default(uuid())
  name          String?
  email         String
  message       String
  screenshotUrl String?
  status        String   @default("OPEN") // OPEN, RESOLVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model VisualBuilderTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  content     Json // Stores the steps array
  category    String // e.g., "custom"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Script {
  id          String   @id @default(uuid())
  name        String
  description String?
  content     String // Stored for download only, never executed on the server
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BackupRecord {
  id            String   @id @default(uuid())
  name          String
  description   String?
  type          String // "LOCAL_DB"
  spaceId       String
  environmentId String?

  /// Legacy: full export inline. New backups live in storage (see storageKey).
  content    Json?
  /// Path of the gzipped JSON export relative to DATA_DIR/backups.
  storageKey String?
  sizeBytes  BigInt?
  stats      Json?

  externalId String?

  createdAt DateTime @default(now())
  hasZip    Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, spaceId])
}

model Job {
  id         String    @id @default(uuid())
  type       String
  status     JobStatus @default(QUEUED)
  /// Validated input. Never contains secrets: workers load the token by userId.
  params     Json
  result     Json?
  error      String?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Last lines of the job log, kept after the live event stream (Redis) expires.
  logTail Json?

  @@index([userId, createdAt])
  @@index([status])
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   @default("INFO") // INFO, WARN, ERROR
  action    String // e.g., "BACKUP_CREATE", "MIGRATION_RUN"
  message   String
  details   Json? // Store detailed metadata or error stacks
  status    String? // SUCCESS, FAILED
  logFile   String? // Legacy
  userId    String?
  userEmail String?
  ip        String?

  timestamp DateTime @default(now())

  @@index([action])
  @@index([level])
  @@index([timestamp])
  @@index([userId, timestamp])
}

model AppSettings {
  id                 String   @id @default("default")
  betaBannerEnabled  Boolean  @default(true)
  betaBannerText     String   @default("🚀 This is a beta version of the app")
  tickerEnabled      Boolean  @default(false)
  tickerText         String   @default("Welcome to the migration tool!")
  maxAssetSizeMB     Int      @default(1024)
  maxBackupsPerUser  Int      @default(1)
  enableAssetBackups Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  updatedBy          String?
}
